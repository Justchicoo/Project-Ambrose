{
 "title": "At the account's wizard limit the client's own creation flow is refused, with the client's failure message and the list unchanged",
 "include": "parts/common.json",
 "requires": {
  "gameserver": true
 },
 "game_settings": [
  "Logger.server=2,Console Server Errors Stream",
  "Realm.Name=Ambrose Driver",
  "Logger.network.session=2,Console Server Errors Stream"
 ],
 "server_log_allowed": [
  "character_create_school holds no school, so no wizard can be created until it does",
  "realmlist holds no realm, so no player can be sent to a gameserver until one is added"
 ],
 "notes": [
  "3.15 and 3.16's slot-limit check: Character.MaxPerAccount is 1 and the account already holds one wizard, so the wizard the client's",
  "creation flow submits is refused with MSG_CREATECHARACTERRESPONSE; the run shots the client's message and checks the list still holds one."
 ],
 "server_settings": [
  "Character.MaxPerAccount=1"
 ],
 "wizard": {
  "school": 2343174,
  "zone": "WizardCity/WC_Ravenwood",
  "zone_display": "Ravenwood",
  "locale": "en-US",
  "first": 1,
  "middle": 1,
  "last": 1,
  "level": 1,
  "appearance": {
   "gender": 1,
   "race": 79806088,
   "hair_model": 6,
   "hair_color": 60,
   "hat_color": 4,
   "hat_decal": 4,
   "torso_color": 4,
   "torso_decal": 4,
   "feet_color": 4,
   "feet_decal": 12
  }
 },
 "steps": [
  {
   "action": "wait_client_log",
   "name": "the client brings its renderer up",
   "pattern": "About to initialize graphical client\\.",
   "timeout": 180
  },
  {
   "action": "wait_screen",
   "name": "the login window is on the screen",
   "screens": [
    "login"
   ],
   "timeout": 120
  },
  {
   "action": "submit_login",
   "name": "log in",
   "password": "{password}"
  },
  {
   "action": "wait_server_log",
   "name": "the server accepts the password",
   "pattern": "authenticated as {user} \\(id \\d+\\)",
   "timeout": 30
  },
  {
   "action": "wait_client_log",
   "name": "the client is admitted",
   "pattern": "The LoginServer has admitted the user",
   "timeout": 30
  },
  {
   "action": "wait_client_log",
   "name": "the character selection scene loads",
   "pattern": "WizardCharacterSelect: The scene has been loaded successfully\\.",
   "timeout": 120
  },
  {
   "action": "wait_screen",
   "name": "the character selection screen is on the screen",
   "screens": [
    "charselect"
   ],
   "timeout": 90
  },
  {
   "action": "click",
   "name": "press the button that starts a new wizard",
   "target": "charselect_new",
   "attempts": 5,
   "on_screen": "charselect",
   "until": {
    "action": "wait_screen",
    "screens": [
     "dialog_next"
    ],
    "timeout": 20
   }
  },
  {
   "action": "shot",
   "name": "the first creation screen",
   "file": "creation-introduction"
  },
  {
   "action": "click",
   "name": "press through the introduction",
   "target": "dialog_next",
   "attempts": 30,
   "dwell": 0.4,
   "dwell_step": 0,
   "until": {
    "action": "wait_screen",
    "screens": [
     "test_book"
    ],
    "timeout": 1.5
   }
  },
  {
   "action": "shot",
   "name": "the sorting test",
   "file": "sorting-test"
  },
  {
   "action": "click",
   "name": "skip the sorting test",
   "target": "test_skip",
   "attempts": 5,
   "until": {
    "action": "wait_screen",
    "screens": [
     "school_list"
    ],
    "timeout": 15
   }
  },
  {
   "action": "shot",
   "name": "the list of schools",
   "file": "school-list"
  },
  {
   "action": "click",
   "name": "choose a school",
   "target": "school_ice",
   "attempts": 5,
   "until": {
    "action": "wait_screen",
    "screens": [
     "school_chosen"
    ],
    "timeout": 15
   }
  },
  {
   "action": "shot",
   "name": "the school chosen",
   "file": "school-chosen"
  },
  {
   "action": "click",
   "name": "confirm the school",
   "target": "school_ok",
   "attempts": 5,
   "until": {
    "action": "wait_screen",
    "screens": [
     "dialog_back"
    ],
    "timeout": 25
   }
  },
  {
   "action": "click",
   "name": "press through the appearance dialogue",
   "target": "dialog_next",
   "attempts": 10,
   "dwell": 0.4,
   "dwell_step": 0,
   "until": {
    "action": "wait_screen",
    "screens": [
     "appearance"
    ],
    "timeout": 3
   }
  },
  {
   "action": "click",
   "name": "take the next look",
   "target": "preset_next",
   "attempts": 1
  },
  {
   "action": "shot",
   "name": "the wizard's appearance",
   "file": "appearance"
  },
  {
   "action": "click",
   "name": "accept the look",
   "target": "appearance_next",
   "attempts": 5,
   "until": {
    "action": "wait_screen",
    "screens": [
     "dialog_back"
    ],
    "timeout": 25
   }
  },
  {
   "action": "click",
   "name": "press through the naming dialogue",
   "target": "dialog_next",
   "attempts": 10,
   "dwell": 0.4,
   "dwell_step": 0,
   "until": {
    "action": "wait_screen",
    "screens": [
     "name"
    ],
    "timeout": 3
   }
  },
  {
   "action": "click",
   "name": "roll a name",
   "target": "name_random",
   "attempts": 3,
   "until": {
    "action": "wait_client_log",
    "pattern": "FirstTableName \\S+, size=\\d+",
    "timeout": 5
   }
  },
  {
   "action": "shot",
   "name": "the name rolled",
   "file": "name-rolled"
  },
  {
   "action": "click",
   "name": "submit the wizard",
   "target": "name_done",
   "attempts": 5,
   "until": {
    "action": "wait_server_log",
    "pattern": "was refused a new character for account \\d+: (.*); sent MSG_CREATECHARACTERRESPONSE",
    "timeout": 15,
    "record": true
   }
  },
  {
   "action": "shot",
   "name": "the client's failure message",
   "file": "refused-at-the-limit",
   "settle": 3
  },
  {
   "action": "wait_db",
   "name": "the account still holds one wizard",
   "database": "characters",
   "query": "SELECT COUNT(*) FROM characters",
   "expect": "1",
   "timeout": 5
  }
 ]
}