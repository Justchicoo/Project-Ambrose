{
  "$description": "Project Ambrose by Imjustchico: the one place a design value is written. apps/designtokens/designtokens.py generates the stylesheet, the TypeScript module, the terminal header and the tables in doc/DESIGN.md from this file.",
  "primitive": {
    "$description": "Raw values. No component ever names one of these; components name a meaning in the semantic tier.",
    "color": {
      "$type": "color",
      "ground": { "$value": "#0B1020", "$description": "The page behind everything" },
      "chrome": { "$value": "#070B16", "$description": "Title bars, side bars, anything framing the page" },
      "panel": { "$value": "#131B31", "$description": "Raised cards and controls" },
      "sunken": { "$value": "#0E1527", "$description": "Inputs, log areas, anything set into the page" },
      "border": { "$value": "#1B2540", "$description": "Quiet separators" },
      "border-strong": { "$value": "#22304F", "$description": "Card and control edges" },
      "text": { "$value": "#F2E8D5", "$description": "Body text on the ground" },
      "text-muted": { "$value": "#A8B6D4", "$description": "Secondary text" },
      "text-faint": { "$value": "#8798BC", "$description": "Labels, timestamps, hints" },
      "gold": { "$value": "#E4B457", "$description": "The one action that matters, and waiting states" },
      "gold-deep": { "$value": "#B98A2D", "$description": "The pressed edge of a gold control" },
      "teal": { "$value": "#5FD3C4", "$description": "Healthy, done, verified" },
      "violet": { "$value": "#C77DFF", "$description": "Marks something the user owns, such as their own wizard" },
      "ember": { "$value": "#E2725B", "$description": "Errors and destructive actions" },
      "parchment": { "$value": "#F4EAD5", "$description": "The light page" },
      "parchment-raised": { "$value": "#FFFDF7", "$description": "Light raised cards and controls" },
      "parchment-sunken": { "$value": "#EADFC4", "$description": "Light inputs and log areas" },
      "parchment-chrome": { "$value": "#FBF5E7", "$description": "Light title bars and side bars" },
      "parchment-border": { "$value": "#D9CBAB", "$description": "Light quiet separators" },
      "parchment-border-strong": { "$value": "#C3AE86", "$description": "Light card and control edges" },
      "ink": { "$value": "#1B1608", "$description": "Body text on parchment" },
      "ink-muted": { "$value": "#4A3F28", "$description": "Secondary text on parchment" },
      "ink-faint": { "$value": "#5F5238", "$description": "Labels, timestamps and hints on parchment" },
      "gold-dark": { "$value": "#7A5A12", "$description": "Gold that can be read on parchment" },
      "gold-darkest": { "$value": "#6A4E0F", "$description": "The pressed edge of a gold control on parchment" },
      "teal-dark": { "$value": "#0F6F63", "$description": "Teal that can be read on parchment" },
      "edge-control": { "$value": "#546AA5", "$description": "A control with nothing else to show it exists" },
      "value-number": { "$value": "#D1988F", "$description": "A number with a unit inside a message" },
      "value-number-dark": { "$value": "#521915", "$description": "A number with a unit that can be read on parchment" },
      "value-text": { "$value": "#B4A5FB", "$description": "Quoted text inside a message" },
      "value-text-dark": { "$value": "#172075", "$description": "Quoted text that can be read on parchment" },
      "value-name": { "$value": "#8EE4A1", "$description": "An identifier inside a message" },
      "value-name-dark": { "$value": "#043415", "$description": "An identifier that can be read on parchment" },
      "value-address": { "$value": "#28BDFA", "$description": "An address, URL or path inside a message" },
      "value-address-dark": { "$value": "#00435C", "$description": "An address, URL or path that can be read on parchment" },
      "value-setting": { "$value": "#E07AAE", "$description": "A configuration option inside a message" },
      "value-setting-dark": { "$value": "#5B013A", "$description": "A configuration option that can be read on parchment" },
      "violet-dark": { "$value": "#6B2FA0", "$description": "Violet that can be read on parchment" },
      "ember-dark": { "$value": "#A33A25", "$description": "Ember that can be read on parchment" }
    },
    "space": {
      "$type": "dimension",
      "4": { "$value": "4px" },
      "6": { "$value": "6px" },
      "8": { "$value": "8px" },
      "10": { "$value": "10px" },
      "12": { "$value": "12px" },
      "14": { "$value": "14px" },
      "16": { "$value": "16px" },
      "20": { "$value": "20px" },
      "22": { "$value": "22px" },
      "28": { "$value": "28px" },
      "34": { "$value": "34px" },
      "40": { "$value": "40px" },
      "44": { "$value": "44px" }
    },
    "radius": {
      "$type": "dimension",
      "control": { "$value": "6px", "$description": "Small controls" },
      "input": { "$value": "8px", "$description": "Inputs" },
      "card": { "$value": "10px", "$description": "Cards" },
      "action": { "$value": "12px", "$description": "The largest action" },
      "pill": { "$value": "999px", "$description": "Pills" }
    },
    "size": {
      "$type": "dimension",
      "11": { "$value": "11px", "$extensions": { "ambrose.leading": "16px" } },
      "12": { "$value": "12px", "$extensions": { "ambrose.leading": "18px" } },
      "13": { "$value": "13px", "$extensions": { "ambrose.leading": "20px" } },
      "15": { "$value": "15px", "$extensions": { "ambrose.leading": "22px" } },
      "17": { "$value": "17px", "$extensions": { "ambrose.leading": "24px" } },
      "21": { "$value": "21px", "$extensions": { "ambrose.leading": "28px" } },
      "26": { "$value": "26px", "$extensions": { "ambrose.leading": "34px" } },
      "34": { "$value": "34px", "$extensions": { "ambrose.leading": "42px" } },
      "44": { "$value": "44px", "$extensions": { "ambrose.leading": "52px" } },
      "56": { "$value": "56px", "$extensions": { "ambrose.leading": "64px" } }
    },
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Cormorant Garamond", "Georgia", "Times New Roman", "serif"], "$description": "Headings, the wordmark, the Play button" },
      "interface": { "$value": ["Karla", "Segoe UI", "Helvetica Neue", "Arial", "sans-serif"], "$description": "Every other piece of text" },
      "mono": { "$value": ["JetBrains Mono", "Cascadia Mono", "Consolas", "DejaVu Sans Mono", "monospace"], "$description": "Numbers, paths, logs, commands" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "duration": {
      "$type": "duration",
      "flip": { "$value": "90ms", "$description": "A state that flips" },
      "hover": { "$value": "120ms", "$description": "A hover" },
      "panel": { "$value": "200ms", "$description": "A panel that opens" },
      "screen": { "$value": "320ms", "$description": "A screen that changes" }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1], "$description": "Everything that moves, with no overshoot" },
      "exit": { "$value": [0.4, 0, 1, 1], "$description": "Something leaving the screen" }
    }
  },
  "semantic": {
    "$description": "The only names a component may use. Each carries the dark value, with the light theme as a remap in $extensions.",
    "color": {
      "$type": "color",
      "surface-page": { "$value": "{primitive.color.ground}", "$extensions": { "ambrose.light": "{primitive.color.parchment}", "ambrose.ansi16": "black", "ambrose.ansi16-light": "bright-white" }, "$description": "The page behind everything" },
      "surface-card": { "$value": "{primitive.color.panel}", "$extensions": { "ambrose.light": "{primitive.color.parchment-raised}", "ambrose.ansi16": "black", "ambrose.ansi16-light": "bright-white" }, "$description": "Raised cards and controls" },
      "surface-sunken": { "$value": "{primitive.color.sunken}", "$extensions": { "ambrose.light": "{primitive.color.parchment-sunken}", "ambrose.ansi16": "black", "ambrose.ansi16-light": "white" }, "$description": "Inputs, log areas, anything set into the page" },
      "surface-chrome": { "$value": "{primitive.color.chrome}", "$extensions": { "ambrose.light": "{primitive.color.parchment-chrome}", "ambrose.ansi16": "black", "ambrose.ansi16-light": "bright-white" }, "$description": "Title bars, side bars, anything framing the page" },
      "edge-quiet": { "$value": "{primitive.color.border}", "$extensions": { "ambrose.light": "{primitive.color.parchment-border}", "ambrose.ansi16": "bright-black", "ambrose.ansi16-light": "white" }, "$description": "Quiet separators" },
      "edge-strong": { "$value": "{primitive.color.border-strong}", "$extensions": { "ambrose.light": "{primitive.color.parchment-border-strong}", "ambrose.ansi16": "bright-black", "ambrose.ansi16-light": "white" }, "$description": "Card and control edges" },
      "edge-control": { "$value": "{primitive.color.edge-control}", "$extensions": { "ambrose.light": "{primitive.color.edge-control}", "ambrose.ansi16": "blue", "ambrose.ansi16-light": "blue" }, "$description": "A control boundary when nothing else shows it exists" },
      "value-number": { "$value": "{primitive.color.value-number}", "$extensions": { "ambrose.light": "{primitive.color.value-number-dark}", "ambrose.ansi16": "red", "ambrose.ansi16-light": "red" }, "$description": "A number with a unit inside a message" },
      "value-text": { "$value": "{primitive.color.value-text}", "$extensions": { "ambrose.light": "{primitive.color.value-text-dark}", "ambrose.ansi16": "blue", "ambrose.ansi16-light": "blue" }, "$description": "Quoted text inside a message" },
      "value-name": { "$value": "{primitive.color.value-name}", "$extensions": { "ambrose.light": "{primitive.color.value-name-dark}", "ambrose.ansi16": "bright-green", "ambrose.ansi16-light": "green" }, "$description": "An identifier inside a message, such as an app, a database or a category" },
      "value-address": { "$value": "{primitive.color.value-address}", "$extensions": { "ambrose.light": "{primitive.color.value-address-dark}", "ambrose.ansi16": "bright-blue", "ambrose.ansi16-light": "blue" }, "$description": "An address, URL, path or connection target inside a message" },
      "value-setting": { "$value": "{primitive.color.value-setting}", "$extensions": { "ambrose.light": "{primitive.color.value-setting-dark}", "ambrose.ansi16": "magenta", "ambrose.ansi16-light": "magenta" }, "$description": "A configuration option inside a message" },
      "fg-body": { "$value": "{primitive.color.text}", "$extensions": { "ambrose.light": "{primitive.color.ink}", "ambrose.ansi16": "bright-white", "ambrose.ansi16-light": "black" }, "$description": "Body text" },
      "fg-muted": { "$value": "{primitive.color.text-muted}", "$extensions": { "ambrose.light": "{primitive.color.ink-muted}", "ambrose.ansi16": "white", "ambrose.ansi16-light": "bright-black" }, "$description": "Secondary text" },
      "fg-faint": { "$value": "{primitive.color.text-faint}", "$extensions": { "ambrose.light": "{primitive.color.ink-faint}", "ambrose.ansi16": "bright-black", "ambrose.ansi16-light": "bright-black" }, "$description": "Labels, timestamps, hints" },
      "action": { "$value": "{primitive.color.gold}", "$extensions": { "ambrose.light": "{primitive.color.gold-dark}", "ambrose.ansi16": "bright-yellow", "ambrose.ansi16-light": "yellow" }, "$description": "The one action that matters" },
      "action-pressed": { "$value": "{primitive.color.gold-deep}", "$extensions": { "ambrose.light": "{primitive.color.gold-darkest}", "ambrose.ansi16": "yellow", "ambrose.ansi16-light": "yellow" }, "$description": "The pressed edge of that action" },
      "state-healthy": { "$value": "{primitive.color.teal}", "$extensions": { "ambrose.light": "{primitive.color.teal-dark}", "ambrose.ansi16": "bright-cyan", "ambrose.ansi16-light": "cyan" }, "$description": "Healthy, done, verified" },
      "state-waiting": { "$value": "{primitive.color.gold}", "$extensions": { "ambrose.light": "{primitive.color.gold-dark}", "ambrose.ansi16": "bright-yellow", "ambrose.ansi16-light": "yellow" }, "$description": "Waiting" },
      "state-wrong": { "$value": "{primitive.color.ember}", "$extensions": { "ambrose.light": "{primitive.color.ember-dark}", "ambrose.ansi16": "bright-red", "ambrose.ansi16-light": "red" }, "$description": "Wrong, and destructive actions" },
      "state-unknown": { "$value": "{primitive.color.text-faint}", "$extensions": { "ambrose.light": "{primitive.color.ink-faint}", "ambrose.ansi16": "bright-black", "ambrose.ansi16-light": "bright-black" }, "$description": "Unknown" },
      "mine": { "$value": "{primitive.color.violet}", "$extensions": { "ambrose.light": "{primitive.color.violet-dark}", "ambrose.ansi16": "bright-magenta", "ambrose.ansi16-light": "magenta" }, "$description": "Something the user owns, such as their own wizard" },
      "focus-ring": { "$value": "{primitive.color.gold}", "$extensions": { "ambrose.light": "{primitive.color.gold-dark}", "ambrose.ansi16": "bright-yellow", "ambrose.ansi16-light": "yellow" }, "$description": "The 2 px ring no component overrides" }
    }
  },
  "component": {
    "$description": "Knobs a component genuinely needs. A filled accent keeps its bright value in both themes and takes a dark label.",
    "color": {
      "$type": "color",
      "fill-action": { "$value": "{primitive.color.gold}", "$extensions": { "ambrose.light": "{primitive.color.gold}" }, "$description": "The primary button's ground" },
      "fill-action-pressed": { "$value": "{primitive.color.gold-deep}", "$extensions": { "ambrose.light": "{primitive.color.gold-deep}" }, "$description": "The primary button while pressed" },
      "fill-danger": { "$value": "{primitive.color.ember}", "$extensions": { "ambrose.light": "{primitive.color.ember}" }, "$description": "The destructive button's ground" },
      "fill-healthy": { "$value": "{primitive.color.teal}", "$extensions": { "ambrose.light": "{primitive.color.teal}" }, "$description": "A filled healthy badge" },
      "fill-mine": { "$value": "{primitive.color.violet}", "$extensions": { "ambrose.light": "{primitive.color.violet}" }, "$description": "A filled badge on something the user owns" },
      "on-fill": { "$value": "{primitive.color.ground}", "$extensions": { "ambrose.light": "{primitive.color.ground}" }, "$description": "The label on any filled accent, in both themes" }
    },
    "size": {
      "$type": "dimension",
      "chrome-bar": { "$value": "44px", "$description": "The height of the chrome bar" },
      "side-bar": { "$value": "236px", "$description": "The width of the panel's side bar" },
      "touch-target": { "$value": "44px", "$description": "The smallest a control may be" },
      "dialog": { "$value": "520px", "$description": "The widest a dialog grows" },
      "focus-ring": { "$value": "2px", "$description": "The width of the focus ring" },
      "border": { "$value": "1px", "$description": "Every border" },
      "action-inset": { "$value": "3px", "$description": "The only shadow: the inset under a gold control" }
    }
  },
  "series": {
    "$description": "Chart series. These never borrow a meaning-carrying accent, they keep their slot across every chart on a page, and a single-series chart uses slot 1.",
    "color": {
      "$type": "color",
      "1": { "$value": "#C9503F", "$extensions": { "ambrose.light": "#B45A5A", "ambrose.ansi16": "red", "ambrose.ansi16-light": "red" }, "$description": "Series one, and any single-series chart" },
      "2": { "$value": "#B8C24E", "$extensions": { "ambrose.light": "#8A7A22", "ambrose.ansi16": "yellow", "ambrose.ansi16-light": "yellow" }, "$description": "Series two" },
      "3": { "$value": "#79C98A", "$extensions": { "ambrose.light": "#2F5A22", "ambrose.ansi16": "bright-green", "ambrose.ansi16-light": "green" }, "$description": "Series three" },
      "4": { "$value": "#2A8F7C", "$extensions": { "ambrose.light": "#2D7E9C", "ambrose.ansi16": "cyan", "ambrose.ansi16-light": "cyan" }, "$description": "Series four" },
      "5": { "$value": "#7D6BD6", "$extensions": { "ambrose.light": "#3B3AA8", "ambrose.ansi16": "bright-blue", "ambrose.ansi16-light": "blue" }, "$description": "Series five" },
      "6": { "$value": "#A560A5", "$extensions": { "ambrose.light": "#6A2A86", "ambrose.ansi16": "magenta", "ambrose.ansi16-light": "magenta" }, "$description": "Series six" },
      "7": { "$value": "#E1A6C4", "$extensions": { "ambrose.light": "#8E2A5C", "ambrose.ansi16": "bright-magenta", "ambrose.ansi16-light": "bright-magenta" }, "$description": "Series seven" }
    }
  },
  "contrast": {
    "$description": "Every pair the generator computes before it writes a file. A pair under its ratio refuses the whole run.",
    "separation": 12.0,
    "rules": [
      {
        "note": "A value highlighted inside a message, on every surface",
        "minimum": 4.5,
        "foregrounds": ["semantic.color.value-number", "semantic.color.value-text", "semantic.color.value-name", "semantic.color.value-address", "semantic.color.value-setting"],
        "backgrounds": ["semantic.color.surface-page", "semantic.color.surface-card", "semantic.color.surface-sunken", "semantic.color.surface-chrome"]
      },
      {
        "note": "A control edge on every surface it may sit on",
        "minimum": 3.0,
        "foregrounds": ["semantic.color.edge-control"],
        "backgrounds": ["semantic.color.surface-page", "semantic.color.surface-card", "semantic.color.surface-sunken", "semantic.color.surface-chrome"]
      },
      {
        "note": "Body, secondary and hint text on every surface",
        "minimum": 4.5,
        "foregrounds": ["semantic.color.fg-body", "semantic.color.fg-muted", "semantic.color.fg-faint"],
        "backgrounds": ["semantic.color.surface-page", "semantic.color.surface-card", "semantic.color.surface-sunken", "semantic.color.surface-chrome"]
      },
      {
        "note": "A state word, an action and an owner mark on every surface",
        "minimum": 4.5,
        "foregrounds": ["semantic.color.action", "semantic.color.action-pressed", "semantic.color.state-healthy", "semantic.color.state-waiting", "semantic.color.state-wrong", "semantic.color.state-unknown", "semantic.color.mine"],
        "backgrounds": ["semantic.color.surface-page", "semantic.color.surface-card", "semantic.color.surface-sunken", "semantic.color.surface-chrome"]
      },
      {
        "note": "The focus ring, which is an indicator rather than text",
        "minimum": 3.0,
        "foregrounds": ["semantic.color.focus-ring"],
        "backgrounds": ["semantic.color.surface-page", "semantic.color.surface-card", "semantic.color.surface-sunken", "semantic.color.surface-chrome"]
      },
      {
        "note": "The label on a filled accent",
        "minimum": 4.5,
        "foregrounds": ["component.color.on-fill"],
        "backgrounds": ["component.color.fill-action", "component.color.fill-action-pressed", "component.color.fill-danger", "component.color.fill-healthy", "component.color.fill-mine"]
      },
      {
        "note": "A chart series, which is a graphical object rather than text",
        "minimum": 3.0,
        "foregrounds": ["series.color.1", "series.color.2", "series.color.3", "series.color.4", "series.color.5", "series.color.6", "series.color.7"],
        "backgrounds": ["semantic.color.surface-page", "semantic.color.surface-card"]
      }
    ]
  }
}
