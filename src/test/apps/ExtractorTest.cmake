# Project Ambrose by Imjustchico
# Runs the extractor to check its usage text, that bad usage, including an option given as another option's value and a command named twice, exits 2, that a missing world database is reported before anything is searched, that a missing install, type dump or database exits 1 with the reason, that on a machine holding a synthetic install AMBROSE_SETUP_MODE=off prints the find and the flag to pass while auto uses it and reports why no type dump could be built from it, and, when AMBROSE_CLIENT_DIR and AMBROSE_TYPE_DUMP_PATH name the user's own install, that a dry run prints every locale's four human table sizes and the seven schools, a levels dry run prints every level table and school, and a bad database is refused, --sql writes the script, and with AMBROSE_TEST_DB a world database dbimport creates is filled twice with the names and levels in one run, passes a dry run's table check, and loads in the game server with every name, school and level; it reports itself skipped when the client checks cannot run.
if(NOT APP OR NOT WORKDIR)
    message(FATAL_ERROR "APP and WORKDIR must be set")
endif()
file(REMOVE_RECURSE "${WORKDIR}")
file(MAKE_DIRECTORY "${WORKDIR}")
set(unsetAll --unset=AMBROSE_CLIENT_DIR --unset=AMBROSE_TYPE_DUMP_PATH --unset=AMBROSE_WORLD_DATABASE_INFO AMBROSE_SETUP_MODE=off)
set(machine "${WORKDIR}/machine")
set(synthetic "${machine}/drive_c/ProgramData/KingsIsle Entertainment/Wizard101")
file(WRITE "${synthetic}/Data/GameData/Root.wad" "not an archive")
file(WRITE "${synthetic}/Bin/revision.dat" "r999999999.Synthetic_1_0\n")
set(machineEnv "ProgramData=${machine}/drive_c/ProgramData" "WINEPREFIX=${machine}" "LOCALAPPDATA=${WORKDIR}/data" "XDG_DATA_HOME=${WORKDIR}/data" --unset=AMBROSE_CLIENT_DIR --unset=AMBROSE_TYPE_DUMP_PATH --unset=AMBROSE_WORLD_DATABASE_INFO)

execute_process(COMMAND "${APP}" --help RESULT_VARIABLE helpResult OUTPUT_VARIABLE helpOutput ERROR_VARIABLE helpError TIMEOUT 30)
if(NOT helpResult EQUAL 0 OR NOT helpOutput MATCHES "Usage: extractor" OR NOT helpOutput MATCHES "--world-db" OR NOT helpOutput MATCHES "levels  every school's base stats")
    message(FATAL_ERROR "extractor --help exited ${helpResult}: ${helpOutput}${helpError}")
endif()

foreach(arguments IN ITEMS "" "bogus" "names;extra" "--bogus;names" "--dry-run;--sql;x.sql;names" "--client" "--sql;--dry-run;names" "--world-db;--dry-run;names" "levels;levels" "names;levels;names")
    execute_process(COMMAND "${APP}" ${arguments} RESULT_VARIABLE usageResult OUTPUT_VARIABLE usageOutput ERROR_VARIABLE usageError TIMEOUT 30)
    if(NOT usageResult EQUAL 2 OR NOT usageError MATCHES "extractor: .*Usage: extractor")
        message(FATAL_ERROR "extractor with arguments '${arguments}' exited ${usageResult} instead of 2: ${usageOutput}${usageError}")
    endif()
endforeach()

execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${machineEnv} AMBROSE_SETUP_MODE=auto "${APP}" names RESULT_VARIABLE firstResult ERROR_VARIABLE firstError TIMEOUT 30)
if(NOT firstResult EQUAL 1 OR NOT firstError MATCHES "name the world database with --world-db" OR firstError MATCHES "found on this machine|extractor: using|type dump")
    message(FATAL_ERROR "extractor without a world database searched the machine or exited ${firstResult}: ${firstError}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${unsetAll} "${APP}" --dry-run names RESULT_VARIABLE noClientResult ERROR_VARIABLE noClientError TIMEOUT 30)
if(NOT noClientResult EQUAL 1 OR NOT noClientError MATCHES "name your install with --client")
    message(FATAL_ERROR "extractor without an install exited ${noClientResult}: ${noClientError}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${machineEnv} AMBROSE_SETUP_MODE=off "${APP}" --dry-run names RESULT_VARIABLE offResult ERROR_VARIABLE offError TIMEOUT 30)
if(NOT offResult EQUAL 1 OR NOT offError MATCHES "extractor: Wizard101 was found on this machine: [^\n]*r999999999\\.Synthetic_1_0" OR NOT offError MATCHES "Pass --client with one of them, or set AMBROSE_SETUP_MODE=auto to use the newest"
        OR NOT offError MATCHES "name your install with --client")
    message(FATAL_ERROR "extractor with AMBROSE_SETUP_MODE=off did not print the install it found and the flag to pass (${offResult}): ${offError}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${machineEnv} AMBROSE_SETUP_MODE=auto "${APP}" --dry-run names RESULT_VARIABLE autoResult ERROR_VARIABLE autoError TIMEOUT 60)
if(NOT autoResult EQUAL 1 OR NOT autoError MATCHES "extractor: cannot build the type dump for [^\n]*r999999999\\.Synthetic_1_0" OR NOT autoError MATCHES "extractor: using the newest install on this machine, [^\n]*r999999999\\.Synthetic_1_0[^\n]*; pass --client to choose otherwise"
        OR NOT autoError MATCHES "name the type dump with --type-dump")
    message(FATAL_ERROR "extractor with AMBROSE_SETUP_MODE=auto did not use the synthetic install and report the type dump it could not build (${autoResult}): ${autoError}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${unsetAll} "${APP}" --client "${WORKDIR}" --dry-run names RESULT_VARIABLE noDumpResult ERROR_VARIABLE noDumpError TIMEOUT 30)
if(NOT noDumpResult EQUAL 1 OR NOT noDumpError MATCHES "name the type dump with --type-dump")
    message(FATAL_ERROR "extractor without a type dump exited ${noDumpResult}: ${noDumpError}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${unsetAll} "${APP}" --client "${WORKDIR}" --type-dump "${WORKDIR}/dump.json" names RESULT_VARIABLE noDatabaseResult ERROR_VARIABLE noDatabaseError TIMEOUT 30)
if(NOT noDatabaseResult EQUAL 1 OR NOT noDatabaseError MATCHES "name the world database with --world-db")
    message(FATAL_ERROR "extractor without a world database exited ${noDatabaseResult}: ${noDatabaseError}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${unsetAll} "${APP}" --client "${WORKDIR}" --type-dump "${WORKDIR}/dump.json" --world-db "not a connection" names RESULT_VARIABLE badDatabaseResult ERROR_VARIABLE badDatabaseError TIMEOUT 30)
if(NOT badDatabaseResult EQUAL 1 OR NOT badDatabaseError MATCHES "the world database connection is not usable")
    message(FATAL_ERROR "extractor with a bad world database exited ${badDatabaseResult}: ${badDatabaseError}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${unsetAll} "${APP}" --client "${WORKDIR}/missing" --type-dump "${WORKDIR}/dump.json" --dry-run names RESULT_VARIABLE noWadResult ERROR_VARIABLE noWadError TIMEOUT 30)
if(NOT noWadResult EQUAL 1 OR NOT noWadError MATCHES "cannot open .*Root\\.wad")
    message(FATAL_ERROR "extractor with a missing install exited ${noWadResult}: ${noWadError}")
endif()

if("$ENV{AMBROSE_CLIENT_DIR}" STREQUAL "" OR "$ENV{AMBROSE_TYPE_DUMP_PATH}" STREQUAL "")
    message(STATUS "extractor test skipped: its client checks need AMBROSE_CLIENT_DIR and AMBROSE_TYPE_DUMP_PATH")
    return()
endif()
execute_process(COMMAND "${APP}" --dry-run names RESULT_VARIABLE dryResult OUTPUT_VARIABLE dryOutput ERROR_VARIABLE dryError TIMEOUT 600)
foreach(expected IN ITEMS "FirstName_HumanMale: de 250, el 154, en-US 250, es 250, fr 250, it 154, pl 154" "FirstName_HumanFemale: de 250, el 144, en-US 250, es 250, fr 250, it 144, pl 144"
        "MiddleName_Human: de 250, el 85, en-US 250, es 250, fr 250, it 85, pl 85" "LastName_Human: de 250, el 79, en-US 250, es 250, fr 250, it 79, pl 79" "character_name_part: 7955 rows in 63 tables" "character_name_disallowed: 4 rows"
        "character_create_school: 7 rows" "Balance 1027491821" "character_create_option: 1 rows" "dry run: nothing was written")
    if(NOT dryResult EQUAL 0 OR NOT dryOutput MATCHES "${expected}")
        message(FATAL_ERROR "extractor --dry-run names exited ${dryResult} without '${expected}': ${dryOutput}${dryError}")
    endif()
endforeach()
execute_process(COMMAND "${APP}" --dry-run levels RESULT_VARIABLE levelsResult OUTPUT_VARIABLE levelsOutput ERROR_VARIABLE levelsError TIMEOUT 600)
foreach(expected IN ITEMS "player_level_stats: 1267 rows for 7 schools" "with level tables: Fire, Ice, Storm, Life, Myth, Death, Balance" "magic_school_template: 16 rows" "magic_school_badge: [0-9]+ rows"
        "m_maxSchoolLevel 180" "magic_xp_encounter_factor: 3 rows" "stat_effect_config: 39 rows" "stat_crit_block_band: 114 rows" "stat_pip_conversion_band: 7 rows" "dry run: nothing was written")
    if(NOT levelsResult EQUAL 0 OR NOT levelsOutput MATCHES "${expected}")
        message(FATAL_ERROR "extractor --dry-run levels exited ${levelsResult} without '${expected}': ${levelsOutput}${levelsError}")
    endif()
endforeach()
execute_process(COMMAND "${APP}" --dry-run --world-db "not a connection" names RESULT_VARIABLE dryDatabaseResult ERROR_VARIABLE dryDatabaseError TIMEOUT 600)
if(NOT dryDatabaseResult EQUAL 1 OR NOT dryDatabaseError MATCHES "the world database connection is not usable")
    message(FATAL_ERROR "extractor --dry-run with a bad world database exited ${dryDatabaseResult}: ${dryDatabaseError}")
endif()
execute_process(COMMAND "${APP}" --sql "${WORKDIR}/names.sql" names RESULT_VARIABLE sqlResult OUTPUT_VARIABLE sqlOutput ERROR_VARIABLE sqlError TIMEOUT 600)
if(NOT sqlResult EQUAL 0 OR NOT sqlOutput MATCHES "wrote [0-9]+ statements to")
    message(FATAL_ERROR "extractor --sql exited ${sqlResult}: ${sqlOutput}${sqlError}")
endif()
file(READ "${WORKDIR}/names.sql" script LIMIT 4096)
if(NOT script MATCHES "^-- Written by the Project Ambrose extractor" OR NOT script MATCHES "START TRANSACTION;")
    message(FATAL_ERROR "extractor --sql wrote an unexpected script: ${script}")
endif()
file(REMOVE "${WORKDIR}/names.sql")

if(NOT DBIMPORT OR NOT DEFINED ENV{AMBROSE_TEST_DB} OR "$ENV{AMBROSE_TEST_DB}" STREQUAL "")
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/TestDatabases.cmake")
ambrose_test_database_info(ambrose_extractor_world worldInfo)
get_filename_component(dbimportDir "${DBIMPORT}" DIRECTORY)
execute_process(COMMAND "${DBIMPORT}" --config "${dbimportDir}/dbimport.conf.dist" --set "LogsDir=${WORKDIR}/logs" --set Appender.Console=1,3,0 --set Appender.DBImport=1,3,0
        --set Updates.EnableDatabases=4 --set LoginDatabaseInfo= --set CharacterDatabaseInfo= "--set=WorldDatabaseInfo=${worldInfo}"
    WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE importResult OUTPUT_VARIABLE importOutput ERROR_VARIABLE importError TIMEOUT 120)
if(NOT importResult EQUAL 0)
    ambrose_test_fail("dbimport could not create the extractor's world database (${importResult}): ${importOutput}${importError}")
endif()
foreach(round IN ITEMS first second)
    execute_process(COMMAND "${APP}" --world-db "${worldInfo}" names levels RESULT_VARIABLE writeResult OUTPUT_VARIABLE writeOutput ERROR_VARIABLE writeError TIMEOUT 600)
    if(NOT writeResult EQUAL 0 OR NOT writeOutput MATCHES "replaced the world tables in" OR NOT writeOutput MATCHES "character_create_school: 7 rows" OR NOT writeOutput MATCHES "player_level_stats: 1267 rows")
        ambrose_test_fail("extractor's ${round} write to the world database exited ${writeResult}: ${writeOutput}${writeError}")
    endif()
endforeach()
execute_process(COMMAND "${APP}" --dry-run --world-db "${worldInfo}" names levels RESULT_VARIABLE checkResult OUTPUT_VARIABLE checkOutput ERROR_VARIABLE checkError TIMEOUT 600)
if(NOT checkResult EQUAL 0 OR NOT checkOutput MATCHES "checked the world tables in")
    ambrose_test_fail("extractor --dry-run against the filled world database exited ${checkResult}: ${checkOutput}${checkError}")
endif()
if(GAMESERVER)
    get_filename_component(gameDir "${GAMESERVER}" DIRECTORY)
    execute_process(COMMAND "${GAMESERVER}" --check --config "${gameDir}/gameserver.conf.dist" --set BindIP=127.0.0.1 --set WorldServerPort=0 --set ClientDir= --set TypeDumpPath=
            --set Appender.Server=1,3,0 --set Appender.Errors=1,3,0 --set Appender.Stream=1,3,0 --set Appender.Console=1,3,0 --set Appender.DB=4,2,0
            --set LoginDatabaseInfo= --set CharacterDatabaseInfo= "--set=WorldDatabaseInfo=${worldInfo}"
        WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE gameResult OUTPUT_VARIABLE gameOutput ERROR_VARIABLE gameError TIMEOUT 120)
    if(NOT gameResult EQUAL 0 OR NOT gameOutput MATCHES "Loaded 63 character name tables holding 7955 names in 7 locales, and 4 disallowed names"
            OR NOT gameOutput MATCHES "Loaded 16 magic schools with level tables for 7 of them up to level 180, and 39 stat settings with 121 band values")
        ambrose_test_fail("the game server did not load the extracted names and levels (${gameResult}): ${gameOutput}${gameError}")
    endif()
endif()
ambrose_drop_test_databases()
