# Project Ambrose by Imjustchico
# Runs localetool to check its usage text, that bad usage exits 2 and a missing archive exits 1, and, when AMBROSE_CLIENT_DIR names the user's own install, that find prints the key of a quest title and takes text after --, check prints a key's text and exits 1 for a missing key, dump prints a table, and locales lists every locale with the one malformed Polish file it skips; it reports itself skipped when the client checks cannot run.
if(NOT APP OR NOT WORKDIR)
    message(FATAL_ERROR "APP and WORKDIR must be set")
endif()
file(REMOVE_RECURSE "${WORKDIR}")
file(MAKE_DIRECTORY "${WORKDIR}")

execute_process(COMMAND "${APP}" --help RESULT_VARIABLE helpResult OUTPUT_VARIABLE helpOutput ERROR_VARIABLE helpError TIMEOUT 30)
if(NOT helpResult EQUAL 0 OR NOT helpOutput MATCHES "Usage: localetool" OR NOT helpOutput MATCHES "check <key>")
    message(FATAL_ERROR "localetool --help exited ${helpResult}: ${helpOutput}${helpError}")
endif()

foreach(arguments IN ITEMS "" "find" "check;A;B" "locales;extra" "translate;x" "--bogus;find;x" "find;x;--locale")
    execute_process(COMMAND "${APP}" ${arguments} RESULT_VARIABLE usageResult OUTPUT_VARIABLE usageOutput ERROR_VARIABLE usageError TIMEOUT 30)
    if(NOT usageResult EQUAL 2 OR NOT usageError MATCHES "localetool: .*Usage: localetool")
        message(FATAL_ERROR "localetool with arguments '${arguments}' exited ${usageResult} instead of 2: ${usageOutput}${usageError}")
    endif()
endforeach()

execute_process(COMMAND "${APP}" --wad "${WORKDIR}/missing.wad" check Items_1 RESULT_VARIABLE missingResult OUTPUT_VARIABLE missingOutput ERROR_VARIABLE missingError TIMEOUT 30)
if(NOT missingResult EQUAL 1 OR NOT missingError MATCHES "cannot open .*missing\\.wad")
    message(FATAL_ERROR "localetool with a missing archive exited ${missingResult}: ${missingOutput}${missingError}")
endif()

if("$ENV{AMBROSE_CLIENT_DIR}" STREQUAL "")
    message(STATUS "localetool test skipped: its client checks need AMBROSE_CLIENT_DIR")
    return()
endif()
execute_process(COMMAND "${APP}" find "To Ravenwood!" RESULT_VARIABLE findResult OUTPUT_VARIABLE findOutput ERROR_VARIABLE findError TIMEOUT 300)
if(NOT findResult EQUAL 0 OR NOT findOutput MATCHES "QuestTitle_00001718")
    message(FATAL_ERROR "localetool find exited ${findResult}: ${findOutput}${findError}")
endif()
execute_process(COMMAND "${APP}" check QuestTitle_00001718 RESULT_VARIABLE checkResult OUTPUT_VARIABLE checkOutput ERROR_VARIABLE checkError TIMEOUT 300)
if(NOT checkResult EQUAL 0 OR NOT checkOutput MATCHES "^To Ravenwood!")
    message(FATAL_ERROR "localetool check exited ${checkResult}: ${checkOutput}${checkError}")
endif()
execute_process(COMMAND "${APP}" check QuestTitle_NoSuchKey RESULT_VARIABLE absentResult OUTPUT_VARIABLE absentOutput ERROR_VARIABLE absentError TIMEOUT 300)
if(NOT absentResult EQUAL 1 OR NOT absentError MATCHES "en-US has no key QuestTitle_NoSuchKey")
    message(FATAL_ERROR "localetool check of a missing key exited ${absentResult}: ${absentOutput}${absentError}")
endif()
execute_process(COMMAND "${APP}" find -- "--not-a-text--" RESULT_VARIABLE dashResult OUTPUT_VARIABLE dashOutput ERROR_VARIABLE dashError TIMEOUT 300)
if(NOT dashResult EQUAL 1)
    message(FATAL_ERROR "localetool find -- with text starting with -- exited ${dashResult} instead of 1: ${dashOutput}${dashError}")
endif()
execute_process(COMMAND "${APP}" dump ZoneLocName RESULT_VARIABLE dumpResult OUTPUT_VARIABLE dumpOutput ERROR_VARIABLE dumpError TIMEOUT 300)
if(NOT dumpResult EQUAL 0 OR NOT dumpOutput MATCHES "ZoneLocName_1451497\tWizard City\\|Ravenwood")
    message(FATAL_ERROR "localetool dump exited ${dumpResult}: ${dumpError}")
endif()
execute_process(COMMAND "${APP}" locales RESULT_VARIABLE localesResult OUTPUT_VARIABLE localesOutput ERROR_VARIABLE localesError TIMEOUT 600)
if(NOT localesResult EQUAL 0 OR NOT localesOutput MATCHES "en-US\t5132 files\t216992 keys\t40 repeated\t0 skipped" OR NOT localesError MATCHES "pl skipped Locale/pl/WizardFurniture\\.lang")
    message(FATAL_ERROR "localetool locales exited ${localesResult}: ${localesOutput}${localesError}")
endif()
