# Project Ambrose by Imjustchico
# Runs typeextract to check its usage text, that bad usage exits 2, that a --client folder without an install exits 1 naming it and writes nothing, and that a --compare dump that is missing or not a dump exits 1 before any extraction and creates no output file; and, when AMBROSE_CLIENT_DIR names the user's own install, that --compare and --out naming the same file still compares with the dump read before it was replaced; it reports itself skipped when the client check cannot run.
if(NOT APP OR NOT WORKDIR)
    message(FATAL_ERROR "APP and WORKDIR must be set")
endif()
file(REMOVE_RECURSE "${WORKDIR}")
file(MAKE_DIRECTORY "${WORKDIR}")

execute_process(COMMAND "${APP}" --help RESULT_VARIABLE helpResult OUTPUT_VARIABLE helpOutput ERROR_VARIABLE helpError TIMEOUT 30)
if(NOT helpResult EQUAL 0 OR NOT helpOutput MATCHES "Usage: typeextract" OR NOT helpOutput MATCHES "--compare <dump>")
    message(FATAL_ERROR "typeextract --help exited ${helpResult}: ${helpOutput}${helpError}")
endif()

foreach(arguments IN ITEMS "--bogus" "extra" "--client" "--out;--quiet" "--compare;--client;x" "--quiet;-x")
    execute_process(COMMAND "${APP}" ${arguments} RESULT_VARIABLE usageResult OUTPUT_VARIABLE usageOutput ERROR_VARIABLE usageError TIMEOUT 30)
    if(NOT usageResult EQUAL 2 OR NOT usageError MATCHES "typeextract: .*Usage: typeextract")
        message(FATAL_ERROR "typeextract with arguments '${arguments}' exited ${usageResult} instead of 2: ${usageOutput}${usageError}")
    endif()
endforeach()

file(MAKE_DIRECTORY "${WORKDIR}/no-install")
execute_process(COMMAND "${APP}" --client "${WORKDIR}/no-install" --out "${WORKDIR}/no-install.json" RESULT_VARIABLE noInstallResult OUTPUT_VARIABLE noInstallOutput ERROR_VARIABLE noInstallError TIMEOUT 120)
if(NOT noInstallResult EQUAL 1 OR NOT noInstallError MATCHES "no-install holds no Wizard101 install" OR EXISTS "${WORKDIR}/no-install.json")
    message(FATAL_ERROR "typeextract with a folder that holds no install exited ${noInstallResult}: ${noInstallOutput}${noInstallError}")
endif()

execute_process(COMMAND "${APP}" --client "${WORKDIR}/no-install" --compare "${WORKDIR}/missing.json" --out "${WORKDIR}/compared.json" RESULT_VARIABLE missingResult OUTPUT_VARIABLE missingOutput ERROR_VARIABLE missingError TIMEOUT 120)
if(NOT missingResult EQUAL 1 OR NOT missingError MATCHES "cannot open .*missing\\.json" OR missingError MATCHES "holds no Wizard101 install" OR EXISTS "${WORKDIR}/compared.json")
    message(FATAL_ERROR "typeextract with a missing comparison dump exited ${missingResult}: ${missingOutput}${missingError}")
endif()

file(WRITE "${WORKDIR}/not-a-dump.json" "{\"version\": 2, \"classes\": [")
execute_process(COMMAND "${APP}" --client "${WORKDIR}/no-install" --compare "${WORKDIR}/not-a-dump.json" --out "${WORKDIR}/compared.json" RESULT_VARIABLE badResult OUTPUT_VARIABLE badOutput ERROR_VARIABLE badError TIMEOUT 120)
if(NOT badResult EQUAL 1 OR NOT badError MATCHES "not-a-dump\\.json is not a type dump" OR badError MATCHES "holds no Wizard101 install" OR EXISTS "${WORKDIR}/compared.json")
    message(FATAL_ERROR "typeextract with a comparison file that is not a dump exited ${badResult}: ${badOutput}${badError}")
endif()

if("$ENV{AMBROSE_CLIENT_DIR}" STREQUAL "")
    message(STATUS "typeextract test skipped: its client check needs AMBROSE_CLIENT_DIR")
    return()
endif()
set(dump "${WORKDIR}/types/replaced.json")
file(WRITE "${dump}" "{\"version\": 2, \"classes\": {}}\n")
execute_process(COMMAND "${APP}" --client "$ENV{AMBROSE_CLIENT_DIR}" --compare "${dump}" --out "${dump}" RESULT_VARIABLE sameResult OUTPUT_VARIABLE sameOutput ERROR_VARIABLE sameError TIMEOUT 3600)
if(NOT sameResult EQUAL 0 OR NOT sameOutput MATCHES "typeextract: ([0-9]+) differences from")
    message(FATAL_ERROR "typeextract comparing with its own output file exited ${sameResult}: ${sameError}")
endif()
set(differences "${CMAKE_MATCH_1}")
if(differences LESS 1000)
    message(FATAL_ERROR "typeextract reported only ${differences} differences from an empty dump it then replaced")
endif()
file(READ "${dump}" header LIMIT 512)
if(NOT header MATCHES "\"extractor\": \"typeextract 1\"")
    message(FATAL_ERROR "typeextract did not write its dump over ${dump}: ${header}")
endif()
file(GLOB leftovers "${WORKDIR}/types/*.partial")
if(leftovers)
    message(FATAL_ERROR "typeextract left temporary files: ${leftovers}")
endif()
