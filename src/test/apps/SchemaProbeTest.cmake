# Project Ambrose by Imjustchico
# Runs schemaprobe to check its usage text and that bad usage exits 2, and, when AMBROSE_CLIENT_DIR and AMBROSE_TYPE_DUMP_PATH name the user's own install and type dump, that a sweep of WC_Hub's archive reads its headerless gamedata.bin, names the unknown class its minigame sigils are from the client program's own strings, and names that class's m_location through the property oracle; it reports itself skipped when the client checks cannot run.
execute_process(COMMAND "${APP}" --help RESULT_VARIABLE helpResult OUTPUT_VARIABLE helpOutput ERROR_VARIABLE helpError TIMEOUT 30)
if(NOT helpResult EQUAL 0 OR NOT helpOutput MATCHES "Usage: schemaprobe" OR NOT helpOutput MATCHES "--program")
    message(FATAL_ERROR "schemaprobe --help exited ${helpResult}: ${helpOutput}${helpError}")
endif()
execute_process(COMMAND "${APP}" --bogus RESULT_VARIABLE bogusResult OUTPUT_VARIABLE bogusOutput ERROR_VARIABLE bogusError TIMEOUT 30)
if(NOT bogusResult EQUAL 2)
    message(FATAL_ERROR "schemaprobe --bogus exited ${bogusResult} instead of 2: ${bogusOutput}${bogusError}")
endif()

if("$ENV{AMBROSE_CLIENT_DIR}" STREQUAL "" OR "$ENV{AMBROSE_TYPE_DUMP_PATH}" STREQUAL "")
    message(STATUS "schemaprobe test skipped: its client checks need AMBROSE_CLIENT_DIR and AMBROSE_TYPE_DUMP_PATH")
    return()
endif()

file(MAKE_DIRECTORY "${WORKDIR}")
set(report "${WORKDIR}/wc_hub.json")
execute_process(COMMAND "${APP}" --wad WizardCity-WC_Hub.wad --output "${report}" RESULT_VARIABLE probeResult OUTPUT_QUIET ERROR_VARIABLE probeError TIMEOUT 600)
if(NOT probeResult EQUAL 0)
    message(FATAL_ERROR "schemaprobe on WizardCity-WC_Hub.wad exited ${probeResult}: ${probeError}")
endif()
file(READ "${report}" json)
string(JSON headerless GET "${json}" summary headerless)
if(headerless LESS 1)
    message(FATAL_ERROR "schemaprobe read no headerless object in WizardCity-WC_Hub.wad, whose gamedata.bin is one")
endif()
string(JSON classes LENGTH "${json}" unknown_classes)
set(named FALSE)
math(EXPR last "${classes} - 1")
foreach(index RANGE ${last})
    string(JSON hash GET "${json}" unknown_classes ${index} hash)
    if(NOT hash EQUAL 234614075)
        continue()
    endif()
    string(JSON matches GET "${json}" unknown_classes ${index} matches)
    string(JSON properties GET "${json}" unknown_classes ${index} properties)
    if(NOT matches MATCHES "class MinigameSigilInfo")
        message(FATAL_ERROR "schemaprobe did not name class hash 234614075 from the client program's strings: ${matches}")
    endif()
    if(NOT properties MATCHES "class Vector3D:m_location \\(known\\)")
        message(FATAL_ERROR "schemaprobe did not name the minigame sigil's m_location: ${properties}")
    endif()
    set(named TRUE)
endforeach()
if(NOT named)
    message(FATAL_ERROR "schemaprobe did not list class hash 234614075, which WC_Hub's gamedata.bin holds six of")
endif()
