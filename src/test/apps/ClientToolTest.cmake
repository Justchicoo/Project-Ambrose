# Project Ambrose by Imjustchico
# Runs the client tool to check its usage text and that bad usage exits 2, and, when AMBROSE_CLIENT_DIR and AMBROSE_TYPE_DUMP_PATH name the user's own install and type dump, that types prints a class the dump holds with its hash, messages prints what the client's own XML says a message carries under its protocol, service and order, wad prints a BINd entry as JSON, and wad reads a zone's gamedata.bin, which carries a versionable object with no BINd header, into a WizZoneData holding the zone's name and its real locations, each a LocationTemplate with a name and a place, rather than the empty lists a wrong property mask gives; it reports itself skipped when the client checks cannot run.
if(NOT APP OR NOT WORKDIR)
    message(FATAL_ERROR "APP and WORKDIR must be set")
endif()
file(REMOVE_RECURSE "${WORKDIR}")
file(MAKE_DIRECTORY "${WORKDIR}")

execute_process(COMMAND "${APP}" --help RESULT_VARIABLE helpResult OUTPUT_VARIABLE helpOutput ERROR_VARIABLE helpError TIMEOUT 30)
if(NOT helpResult EQUAL 0 OR NOT helpOutput MATCHES "Usage: client" OR NOT helpOutput MATCHES "messages" OR NOT helpOutput MATCHES "wad")
    message(FATAL_ERROR "client --help exited ${helpResult}: ${helpOutput}${helpError}")
endif()

foreach(arguments IN ITEMS "" "--bogus" "types" "messages" "wad")
    execute_process(COMMAND "${APP}" ${arguments} RESULT_VARIABLE usageResult OUTPUT_VARIABLE usageOutput ERROR_VARIABLE usageError TIMEOUT 30)
    if(NOT usageResult EQUAL 2)
        message(FATAL_ERROR "client with arguments '${arguments}' exited ${usageResult} instead of 2: ${usageOutput}${usageError}")
    endif()
endforeach()

if("$ENV{AMBROSE_CLIENT_DIR}" STREQUAL "" OR "$ENV{AMBROSE_TYPE_DUMP_PATH}" STREQUAL "")
    message(STATUS "client tool test skipped: its client checks need AMBROSE_CLIENT_DIR and AMBROSE_TYPE_DUMP_PATH")
    return()
endif()

execute_process(COMMAND "${APP}" types "class WizItemTemplate" RESULT_VARIABLE typesResult OUTPUT_VARIABLE typesOutput ERROR_VARIABLE typesError TIMEOUT 300)
if(NOT typesResult EQUAL 0 OR NOT typesOutput MATCHES "class WizItemTemplate")
    message(FATAL_ERROR "client types did not print the class (${typesResult}): ${typesOutput}${typesError}")
endif()

execute_process(COMMAND "${APP}" messages MSG_CHARACTERSELECTED RESULT_VARIABLE messagesResult OUTPUT_VARIABLE messagesOutput ERROR_VARIABLE messagesError TIMEOUT 300)
if(NOT messagesResult EQUAL 0 OR NOT messagesOutput MATCHES "LOGIN MSG_CHARACTERSELECTED \\(7:[0-9]+\\)" OR NOT messagesOutput MATCHES "LoginServer")
    message(FATAL_ERROR "client messages did not print what the message carries (${messagesResult}): ${messagesOutput}${messagesError}")
endif()

set(hat "ObjectData/CrownItems/Series58/Hats/Crowns-S58-Hats-L110-BS-008-01.xml")
execute_process(COMMAND "${APP}" wad "${hat}" RESULT_VARIABLE hatResult OUTPUT_VARIABLE hatOutput ERROR_VARIABLE hatError TIMEOUT 300)
if(NOT hatResult EQUAL 0 OR NOT hatOutput MATCHES "class WizItemTemplate" OR NOT hatOutput MATCHES "1652259")
    message(FATAL_ERROR "client wad did not print the crown hat (${hatResult}): ${hatOutput}${hatError}")
endif()

set(zone "$ENV{AMBROSE_CLIENT_DIR}/Data/GameData/WizardCity-WC_Hub.wad")
if(NOT EXISTS "${zone}")
    message(STATUS "client tool test: ${zone} is not in this install, so the headerless object check is skipped")
    return()
endif()
execute_process(COMMAND "${APP}" --wad "${zone}" wad gamedata.bin RESULT_VARIABLE zoneResult OUTPUT_VARIABLE zoneOutput ERROR_VARIABLE zoneError TIMEOUT 300)
if(NOT zoneResult EQUAL 0 OR NOT zoneOutput MATCHES "class WizZoneData")
    message(FATAL_ERROR "client wad did not read the zone's headerless object (${zoneResult}): ${zoneError}")
endif()
if(NOT zoneOutput MATCHES "WizardCity/WC_Hub")
    message(FATAL_ERROR "the zone decoded without its name, so its properties were filtered away: ${zoneError}")
endif()
string(REGEX MATCHALL "class LocationTemplate" locations "${zoneOutput}")
list(LENGTH locations locationCount)
if(locationCount LESS 2)
    message(FATAL_ERROR "the zone decoded with ${locationCount} location(s), so its lists came back empty rather than full")
endif()
message(STATUS "client tool: the zone's headerless object decoded with ${locationCount} location(s)")
