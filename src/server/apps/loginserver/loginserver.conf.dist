# Project Ambrose by Imjustchico
# Default settings for the loginserver; copy to loginserver.conf and edit, see doc/config/loginserver.md.
LogsDir = logs
BindIP = 0.0.0.0
LoginServerPort = 12000
Patch.Enabled = 0
ClientDir =
TypeDumpPath =
Setup.Discover = 1
Setup.Prompt = 1
Setup.PromptTimeout = 120
ObjectProperty.MaxDepth = 64
ObjectProperty.MaxObjects = 65536
ObjectProperty.MaxContainerCount = 65536
ObjectProperty.MaxDecodedBytes = 16777216
ObjectProperty.MaxInflatedSize = 4194304
LoginDatabaseInfo = "127.0.0.1;3306;ambrose;ambrose;ambrose_login"
LoginDatabase.WorkerThreads = 1
LoginDatabase.SynchThreads = 1
CharacterDatabaseInfo = "127.0.0.1;3306;ambrose;ambrose;ambrose_characters"
CharacterDatabase.WorkerThreads = 1
CharacterDatabase.SynchThreads = 1
MaxPingTime = 30
Updates.EnableDatabases = 3
Updates.AutoSetup = 1
Updates.SourcePath =
Account.UsernameMinLength = 3
Account.PasswordMinLength = 4
Account.VerifierKeys =
Account.VerifierActiveKey = 0
Account.AllowPlainVerifiers = 1
Login.Name = Ambrose
Login.EnforceRevision = 0
Login.AllowedRevision =
Login.MaxAuthAttempts = 5
Login.LockoutSeconds = 900
Login.DuplicateLoginPolicy = 1
Login.SessionKeyLifetime = 108000
Login.AfkTimeout = 360
Login.AfkWarning = 1
Login.ShutdownGrace = 5
Network.Threads = 1
Network.MaxFrameSize = 4194304
Network.MaxDmlMessages = 1024
Network.MaxSendQueueBytes = 16777216
Network.LongFrameLength = BodyOnly
Network.OutKBuff = -1
Network.TcpNoDelay = 1
Network.SessionAcceptTimeout = 15
Network.KeepAliveInterval = 60
Network.KeepAliveTimeout = 15
Network.MaxStrikes = 10
Network.DroppedMessageBurst = 64
Network.DroppedMessagesPerSecond = 16
Network.PingBurst = 16
Network.PingsPerSecond = 4
Log.Async.Enable = 0
Log.Async.QueueSize = 65536
Log.Async.QueueFull = 0
Log.Utc = 0
Log.PendingBuffer = 1000
Console.Colors = 1
Console.Enable = 1
Appender.Console = 1,3,3,"1 9 3 6 5 8"
Appender.Server = 2,2,7,Login.log,w
Appender.Errors = 2,4,7,LoginErrors.log,a,16M,10
Appender.Stream = 3,2,0,1000
Logger.root = 3,Console Server Errors Stream
Logger.server = 3,Console Server Errors Stream
Logger.sql = 4,Console Server Errors Stream
Logger.sql.driver = 3,Console Server Errors Stream
Logger.sql.updates = 3,Console Server Errors Stream
Logger.network = 3,Console Server Errors Stream
Logger.network.session = 2,Console Server Errors Stream
Logger.network.opcode = 2,Console Server Errors Stream
