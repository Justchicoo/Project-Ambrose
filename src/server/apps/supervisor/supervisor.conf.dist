# Project Ambrose by Imjustchico
# Default settings for the supervisor; copy to supervisor.conf and edit, see doc/config/supervisor.md.
LogsDir = logs
Supervisor.Apps = loginserver gameserver patchserver
Supervisor.StateFile =
Supervisor.OutputDir =
Supervisor.OutputMaxBytes = 16777216
App.loginserver.Program = loginserver
App.loginserver.Config = loginserver.conf
App.loginserver.WorkingDirectory =
App.loginserver.Autostart = 1
App.loginserver.StartTimeout = 120
App.loginserver.StopTimeout = 60
App.gameserver.Program = gameserver
App.gameserver.Config = gameserver.conf
App.gameserver.WorkingDirectory =
App.gameserver.Autostart = 1
App.gameserver.StartTimeout = 120
App.gameserver.StopTimeout = 60
App.patchserver.Program = patchserver
App.patchserver.Config = patchserver.conf
App.patchserver.WorkingDirectory =
App.patchserver.Autostart = 1
App.patchserver.StartTimeout = 120
App.patchserver.StopTimeout = 60
Admin.Enable = 1
Admin.BindIP = 127.0.0.1
Admin.Port = 12020
Admin.Token =
Admin.TokenFile =
Admin.AllowPlainHttpRemote = 0
Admin.CertificateFile =
Admin.PrivateKeyFile =
Admin.AuthFailureBurst = 10
Admin.AuthFailuresPerSecond = 1
Admin.MaxRequestBytes = 262144
Admin.Threads = 8
Admin.DashboardDir =
Admin.AllowedHosts =
Admin.SessionIdleMinutes = 720
Admin.SessionLifetimeHours = 168
Panel.Enable = 0
Panel.BindIP = 127.0.0.1
Panel.Port = 12080
Panel.Token =
Panel.TokenFile =
Panel.AllowPlainHttpRemote = 0
Panel.CertificateFile =
Panel.PrivateKeyFile =
Panel.AuthFailureBurst = 10
Panel.AuthFailuresPerSecond = 1
Panel.MaxRequestBytes = 262144
Panel.Threads = 8
Panel.DashboardDir =
Panel.AllowedHosts =
Panel.SessionIdleMinutes = 720
Panel.SessionLifetimeHours = 168
Panel.TrustedProxies =
Panel.RateLimitBurst = 120
Panel.RateLimitPerSecond = 2
Panel.StoreFile =
Log.Async.Enable = 0
Log.Async.QueueSize = 65536
Log.Async.QueueFull = 0
Log.Utc = 0
Log.PendingBuffer = 1000
Console.Colors = 1
Console.Enable = 1
Appender.Console = 1,3,7,"1 9 3 13 7 7"
Appender.Server = 2,2,7,Supervisor.log,w
Appender.Errors = 2,4,7,SupervisorErrors.log,a,16M,10
Appender.Stream = 3,2,0,1000
Logger.root = 3,Console Server Errors Stream
Logger.server = 3,Console Server Errors Stream
Logger.network = 3,Console Server Errors Stream
