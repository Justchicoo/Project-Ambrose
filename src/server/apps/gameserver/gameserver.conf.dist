# Project Ambrose by Imjustchico
# Default settings for the gameserver; copy to gameserver.conf and edit, see doc/config/gameserver.md.
LogsDir = logs
WorldServerPort = 12000
Log.Async.Enable = 0
Log.Async.QueueSize = 65536
Log.Async.QueueFull = 0
Log.Utc = 0
Log.PendingBuffer = 1000
Console.Colors = 1
Appender.Console = 1,3,3,"1 9 3 6 5 8"
Appender.Server = 2,2,7,Server.log,w
Appender.Errors = 2,4,7,Errors.log,a,16M,10
Appender.Stream = 3,2,0,1000
Logger.root = 3,Console Server Errors Stream
Logger.server = 3,Console Server Errors Stream
Logger.sql = 4,Console Server Errors Stream
Logger.network = 3,Console Server Errors Stream
