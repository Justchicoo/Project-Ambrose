# Project Ambrose by Imjustchico
# Default settings for the patchserver; copy to patchserver.conf and edit, see doc/config/patchserver.md.
LogsDir = logs
BindIP = 0.0.0.0
PatchServerPort = 12500
Network.Threads = 1
Network.MaxFrameSize = 4194304
Network.MaxDmlMessages = 1024
Network.MaxSendQueueBytes = 16777216
Network.LongFrameLength = BodyOnly
Network.OutKBuff = -1
Network.TcpNoDelay = 1
Admin.Enable = 0
Admin.BindIP = 127.0.0.1
Admin.Port = 12510
Admin.Token =
Admin.TokenFile =
Admin.AllowPlainHttpRemote = 0
Admin.CertificateFile =
Admin.PrivateKeyFile =
Admin.AuthFailureBurst = 10
Admin.AuthFailuresPerSecond = 1
Admin.MaxRequestBytes = 262144
Admin.Threads = 2
Admin.DashboardDir =
Admin.AllowedHosts =
Admin.SessionIdleMinutes = 720
Admin.SessionLifetimeHours = 168
Log.Async.Enable = 0
Log.Async.QueueSize = 65536
Log.Async.QueueFull = 0
Log.Utc = 0
Log.PendingBuffer = 1000
Console.Colors = 1
Console.Enable = 1
Appender.Console = 1,3,7,"1 9 3 13 7 7"
Appender.Server = 2,2,7,Patch.log,w
Appender.Errors = 2,4,7,PatchErrors.log,a,16M,10
Appender.Stream = 3,2,0,1000
Logger.root = 3,Console Server Errors Stream
Logger.server = 3,Console Server Errors Stream
Logger.sql = 4,Console Server Errors Stream
Logger.network = 3,Console Server Errors Stream
