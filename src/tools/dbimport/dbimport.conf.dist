# Project Ambrose by Imjustchico
# Default settings for dbimport; copy to dbimport.conf and edit, see doc/config/dbimport.md.
LogsDir = logs
LoginDatabaseInfo = "127.0.0.1;3306;ambrose;ambrose;ambrose_login"
LoginDatabase.WorkerThreads = 1
LoginDatabase.SynchThreads = 1
CharacterDatabaseInfo = "127.0.0.1;3306;ambrose;ambrose;ambrose_characters"
CharacterDatabase.WorkerThreads = 1
CharacterDatabase.SynchThreads = 1
WorldDatabaseInfo = "127.0.0.1;3306;ambrose;ambrose;ambrose_world"
WorldDatabase.WorkerThreads = 1
WorldDatabase.SynchThreads = 1
MaxPingTime = 30
Updates.EnableDatabases = 7
Updates.AutoSetup = 1
Updates.SourcePath =
Updates.Redundancy = 0
Updates.AllowRehash = 0
Updates.CleanDeadRefMaxCount = 3
Updates.AllowPending = 0
Log.Async.Enable = 0
Log.Utc = 0
Console.Colors = 1
Appender.Console = 1,3,3,"1 9 3 13 7 7"
Appender.DBImport = 2,2,7,DBImport.log,w
Logger.root = 3,Console DBImport
Logger.sql = 4,Console DBImport
Logger.sql.driver = 3,Console DBImport
Logger.sql.updates = 3,Console DBImport
