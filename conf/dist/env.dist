# Project Ambrose by Imjustchico
# Environment override template: each AMBROSE_ variable replaces the matching option from every .conf layer.
AMBROSE_INSTALL_PREFIX=env/dist
AMBROSE_BUILD_TYPE=Debug
AMBROSE_PRESET=
AMBROSE_LOGS_DIR=logs
AMBROSE_WORLD_SERVER_PORT=12333
AMBROSE_LOG_ASYNC_ENABLE=0
AMBROSE_LOG_UTC=0
