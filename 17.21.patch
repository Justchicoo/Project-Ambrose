diff --git a/src/server/apps/supervisor/Panel/PanelAccounts.cpp b/src/server/apps/supervisor/Panel/PanelAccounts.cpp
new file mode 100644
index 0000000..361b6bb
--- /dev/null
+++ b/src/server/apps/supervisor/Panel/PanelAccounts.cpp
@@ -0,0 +1,367 @@
+/*
+ * Project Ambrose by Imjustchico
+ * The game-master account and ban console for the panel: searching accounts, creating them, resetting passwords, locking, security levels, and bans, each checked against the caller's command level and audited either way, with PII hidden from callers without the grant.
+ */
+
+#include "PanelAccounts.h"
+
+#include <nlohmann/json.hpp>
+
+#include <algorithm>
+#include <cctype>
+
+namespace
+{
+    bool EqualsFold(std::string_view a, std::string_view b)
+    {
+        if (a.size() != b.size())
+            return false;
+        for (std::size_t i = 0; i < a.size(); ++i)
+            if (std::tolower(static_cast<unsigned char>(a[i])) != std::tolower(static_cast<unsigned char>(b[i])))
+                return false;
+        return true;
+    }
+
+    bool ContainsFold(std::string_view haystack, std::string_view needle)
+    {
+        if (needle.empty())
+            return true;
+        std::string h(haystack), n(needle);
+        std::transform(h.begin(), h.end(), h.begin(), [](unsigned char c) { return std::tolower(c); });
+        std::transform(n.begin(), n.end(), n.begin(), [](unsigned char c) { return std::tolower(c); });
+        return h.find(n) != std::string::npos;
+    }
+}
+
+bool PanelAccounts::MayActOn(Caller const& caller, PanelAccountRecord const& target) const
+{
+    return target.SecurityLevel < caller.CommandLevel;
+}
+
+nlohmann::json PanelAccounts::AccountJson(PanelAccountRecord const& record, bool showPii)
+{
+    nlohmann::json answer;
+    answer["id"] = record.Id;
+    answer["username"] = record.Username;
+    answer["security_level"] = record.SecurityLevel;
+    answer["locked"] = record.Locked;
+    answer["online"] = record.Online;
+    answer["join_date"] = record.JoinDate;
+    answer["last_login"] = record.LastLogin;
+    answer["banned"] = record.Banned;
+    answer["ban_until"] = record.BanUntil;
+    if (showPii)
+    {
+        answer["email"] = record.Email;
+        answer["last_address"] = record.LastAddress;
+        answer["last_machine_id"] = record.LastMachineId;
+    }
+    return answer;
+}
+
+nlohmann::json PanelAccounts::BanJson(PanelBanRecord const& record)
+{
+    nlohmann::json answer;
+    answer["kind"] = record.Kind;
+    answer["target"] = record.Target;
+    answer["banned_at"] = record.BannedAt;
+    answer["unban_at"] = record.UnbanAt;
+    answer["banned_by"] = record.BannedBy;
+    answer["reason"] = record.Reason;
+    return answer;
+}
+
+nlohmann::json PanelAccounts::CharacterJson(PanelCharacterRecord const& record)
+{
+    nlohmann::json answer;
+    answer["id"] = record.Id;
+    answer["name"] = record.Name;
+    answer["level"] = record.Level;
+    answer["school"] = record.School;
+    answer["location"] = record.Location;
+    answer["deleted"] = record.Deleted;
+    return answer;
+}
+
+std::string_view PanelAccounts::Describe(PanelAccountResult result) noexcept
+{
+    switch (result)
+    {
+        case PanelAccountResult::Ok: return "ok";
+        case PanelAccountResult::NotFound: return "no such account";
+        case PanelAccountResult::NameInvalid: return "invalid name";
+        case PanelAccountResult::NameTaken: return "name taken";
+        case PanelAccountResult::PasswordInvalid: return "invalid password";
+        case PanelAccountResult::PermissionDenied: return "permission denied";
+        case PanelAccountResult::LevelTooHigh: return "target outranks the caller";
+        case PanelAccountResult::ReasonRequired: return "a reason is required";
+        case PanelAccountResult::StoreFailed: return "store failed";
+    }
+    return "unknown";
+}
+
+nlohmann::json PanelAccounts::Search(Caller const& caller, std::string_view query) const
+{
+    nlohmann::json answer = nlohmann::json::array();
+    if (!caller.CanRead)
+        return answer;
+    for (PanelAccountRecord const& record : _backend.Search(query))
+        answer.push_back(AccountJson(record, caller.CanReadPii));
+    return answer;
+}
+
+nlohmann::json PanelAccounts::Get(Caller const& caller, uint64 id) const
+{
+    if (!caller.CanRead)
+        return nullptr;
+    std::optional<PanelAccountRecord> const record = _backend.Get(id);
+    if (!record)
+        return nullptr;
+    return AccountJson(*record, caller.CanReadPii);
+}
+
+nlohmann::json PanelAccounts::Create(Caller const& caller, std::string_view username, std::string_view password, std::string_view email, PanelAccountResult& result) const
+{
+    if (!caller.CanCreate)
+    {
+        result = PanelAccountResult::PermissionDenied;
+        return nullptr;
+    }
+    uint64 id = 0;
+    result = _backend.Create(username, password, email, id);
+    if (result != PanelAccountResult::Ok)
+        return nullptr;
+    std::optional<PanelAccountRecord> const record = _backend.Get(id);
+    if (!record)
+    {
+        result = PanelAccountResult::StoreFailed;
+        return nullptr;
+    }
+    return AccountJson(*record, caller.CanReadPii);
+}
+
+nlohmann::json PanelAccounts::ResetPassword(Caller const& caller, uint64 id, PanelAccountResult& result, std::string& generated) const
+{
+    if (!caller.CanSetPassword)
+    {
+        result = PanelAccountResult::PermissionDenied;
+        return nullptr;
+    }
+    std::optional<PanelAccountRecord> const record = _backend.Get(id);
+    if (!record)
+    {
+        result = PanelAccountResult::NotFound;
+        return nullptr;
+    }
+    if (!MayActOn(caller, *record))
+    {
+        result = PanelAccountResult::LevelTooHigh;
+        return nullptr;
+    }
+    result = _backend.SetPassword(id, {}, generated);
+    if (result != PanelAccountResult::Ok)
+        return nullptr;
+    nlohmann::json answer;
+    answer["id"] = id;
+    answer["password"] = generated;
+    return answer;
+}
+
+nlohmann::json PanelAccounts::SetLocked(Caller const& caller, uint64 id, bool locked, std::string_view reason, PanelAccountResult& result) const
+{
+    if (!caller.CanEdit)
+    {
+        result = PanelAccountResult::PermissionDenied;
+        return nullptr;
+    }
+    if (reason.empty())
+    {
+        result = PanelAccountResult::ReasonRequired;
+        return nullptr;
+    }
+    std::optional<PanelAccountRecord> const record = _backend.Get(id);
+    if (!record)
+    {
+        result = PanelAccountResult::NotFound;
+        return nullptr;
+    }
+    if (!MayActOn(caller, *record))
+    {
+        result = PanelAccountResult::LevelTooHigh;
+        return nullptr;
+    }
+    result = _backend.SetLocked(id, locked);
+    if (result != PanelAccountResult::Ok)
+        return nullptr;
+    std::optional<PanelAccountRecord> const updated = _backend.Get(id);
+    return updated ? AccountJson(*updated, caller.CanReadPii) : nullptr;
+}
+
+nlohmann::json PanelAccounts::SetSecurityLevel(Caller const& caller, uint64 id, uint8 level, std::string_view reason, PanelAccountResult& result) const
+{
+    if (!caller.CanEdit)
+    {
+        result = PanelAccountResult::PermissionDenied;
+        return nullptr;
+    }
+    if (reason.empty())
+    {
+        result = PanelAccountResult::ReasonRequired;
+        return nullptr;
+    }
+    std::optional<PanelAccountRecord> const record = _backend.Get(id);
+    if (!record)
+    {
+        result = PanelAccountResult::NotFound;
+        return nullptr;
+    }
+    if (!MayActOn(caller, *record) || level >= caller.CommandLevel)
+    {
+        result = PanelAccountResult::LevelTooHigh;
+        return nullptr;
+    }
+    result = _backend.SetSecurityLevel(id, level);
+    if (result != PanelAccountResult::Ok)
+        return nullptr;
+    std::optional<PanelAccountRecord> const updated = _backend.Get(id);
+    return updated ? AccountJson(*updated, caller.CanReadPii) : nullptr;
+}
+
+nlohmann::json PanelAccounts::Ban(Caller const& caller, std::string_view kind, std::string_view target, uint64 seconds, std::string_view reason, PanelAccountResult& result) const
+{
+    if (!caller.CanBan)
+    {
+        result = PanelAccountResult::PermissionDenied;
+        return nullptr;
+    }
+    if (reason.empty())
+    {
+        result = PanelAccountResult::ReasonRequired;
+        return nullptr;
+    }
+    std::string const by = caller.Username;
+    if (EqualsFold(kind, "account"))
+    {
+        uint64 id = 0;
+        try { id = std::stoull(std::string(target)); } catch (...) { result = PanelAccountResult::NotFound; return nullptr; }
+        std::optional<PanelAccountRecord> const record = _backend.Get(id);
+        if (!record)
+        {
+            result = PanelAccountResult::NotFound;
+            return nullptr;
+        }
+        if (!MayActOn(caller, *record))
+        {
+            result = PanelAccountResult::LevelTooHigh;
+            return nullptr;
+        }
+        result = _backend.BanAccount(id, seconds, by, reason);
+    }
+    else if (EqualsFold(kind, "address"))
+    {
+        result = _backend.BanAddress(target, seconds, by, reason);
+    }
+    else if (EqualsFold(kind, "machine"))
+    {
+        uint64 machineId = 0;
+        try { machineId = std::stoull(std::string(target)); } catch (...) { result = PanelAccountResult::NotFound; return nullptr; }
+        result = _backend.BanMachine(machineId, seconds, by, reason);
+    }
+    else
+    {
+        result = PanelAccountResult::NotFound;
+        return nullptr;
+    }
+    if (result != PanelAccountResult::Ok)
+        return nullptr;
+    nlohmann::json answer;
+    answer["kind"] = std::string(kind);
+    answer["target"] = std::string(target);
+    answer["seconds"] = seconds;
+    return answer;
+}
+
+nlohmann::json PanelAccounts::Unban(Caller const& caller, std::string_view kind, std::string_view target, std::string_view reason, PanelAccountResult& result) const
+{
+    if (!caller.CanUnban)
+    {
+        result = PanelAccountResult::PermissionDenied;
+        return nullptr;
+    }
+    if (reason.empty())
+    {
+        result = PanelAccountResult::ReasonRequired;
+        return nullptr;
+    }
+    if (EqualsFold(kind, "account"))
+    {
+        uint64 id = 0;
+        try { id = std::stoull(std::string(target)); } catch (...) { result = PanelAccountResult::NotFound; return nullptr; }
+        result = _backend.UnbanAccount(id, reason);
+    }
+    else if (EqualsFold(kind, "address"))
+    {
+        result = _backend.UnbanAddress(target, reason);
+    }
+    else if (EqualsFold(kind, "machine"))
+    {
+        uint64 machineId = 0;
+        try { machineId = std::stoull(std::string(target)); } catch (...) { result = PanelAccountResult::NotFound; return nullptr; }
+        result = _backend.UnbanMachine(machineId, reason);
+    }
+    else
+    {
+        result = PanelAccountResult::NotFound;
+        return nullptr;
+    }
+    if (result != PanelAccountResult::Ok)
+        return nullptr;
+    nlohmann::json answer;
+    answer["kind"] = std::string(kind);
+    answer["target"] = std::string(target);
+    return answer;
+}
+
+nlohmann::json PanelAccounts::ListBans(Caller const& caller) const
+{
+    nlohmann::json answer = nlohmann::json::array();
+    if (!caller.CanRead)
+        return answer;
+    for (PanelBanRecord const& record : _backend.ListBans())
+        answer.push_back(BanJson(record));
+    return answer;
+}
+
+nlohmann::json PanelAccounts::Characters(Caller const& caller, uint64 accountId) const
+{
+    nlohmann::json answer = nlohmann::json::array();
+    if (!caller.CanReadCharacters)
+        return answer;
+    for (PanelCharacterRecord const& record : _backend.CharactersOf(accountId))
+        answer.push_back(CharacterJson(record));
+    return answer;
+}
+
+nlohmann::json PanelAccounts::TopSearch(Caller const& caller, std::string_view query) const
+{
+    nlohmann::json answer = nlohmann::json::array();
+    if (query.empty())
+        return answer;
+    if (caller.CanRead)
+    {
+        for (PanelAccountRecord const& record : _backend.Search(query))
+        {
+            if (!ContainsFold(record.Username, query))
+                continue;
+            nlohmann::json row;
+            row["kind"] = "account";
+            row["id"] = record.Id;
+            row["title"] = record.Username;
+            row["path"] = "/accounts/" + std::to_string(record.Id);
+            answer.push_back(row);
+            if (answer.size() >= 8)
+                break;
+        }
+    }
+    return answer;
+}
diff --git a/src/server/apps/supervisor/Panel/PanelAccounts.h b/src/server/apps/supervisor/Panel/PanelAccounts.h
new file mode 100644
index 0000000..35a0970
--- /dev/null
+++ b/src/server/apps/supervisor/Panel/PanelAccounts.h
@@ -0,0 +1,132 @@
+/*
+ * Project Ambrose by Imjustchico
+ * The game-master account and ban console for the panel: searching accounts by username, email, address or machine id, creating them, resetting a password so the new verifier is sealed and every session dies, locking and unlocking, setting the security level, and banning and unbanning accounts, addresses and machines, each action checked against the caller's command level and grants, refused loudly and audited either way, with email, address and machine id hidden from callers without the PII grant.
+ */
+
+#ifndef AMBROSE_PANELACCOUNTS_H
+#define AMBROSE_PANELACCOUNTS_H
+
+#include "Types.h"
+
+#include <nlohmann/json_fwd.hpp>
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+enum class PanelAccountResult : uint8
+{
+    Ok,
+    NotFound,
+    NameInvalid,
+    NameTaken,
+    PasswordInvalid,
+    PermissionDenied,
+    LevelTooHigh,
+    ReasonRequired,
+    StoreFailed
+};
+
+struct PanelAccountRecord
+{
+    uint64 Id = 0;
+    std::string Username;
+    std::string Email;
+    std::string LastAddress;
+    uint64 LastMachineId = 0;
+    uint8 SecurityLevel = 0;
+    bool Locked = false;
+    bool Online = false;
+    uint64 JoinDate = 0;
+    uint64 LastLogin = 0;
+    bool Banned = false;
+    uint64 BanUntil = 0;
+};
+
+struct PanelBanRecord
+{
+    std::string Kind;
+    std::string Target;
+    uint64 BannedAt = 0;
+    uint64 UnbanAt = 0;
+    std::string BannedBy;
+    std::string Reason;
+};
+
+struct PanelCharacterRecord
+{
+    uint64 Id = 0;
+    std::string Name;
+    uint8 Level = 0;
+    uint8 School = 0;
+    std::string Location;
+    bool Deleted = false;
+};
+
+class AccountBackend
+{
+public:
+    virtual ~AccountBackend() = default;
+
+    virtual std::vector<PanelAccountRecord> Search(std::string_view query) = 0;
+    virtual std::optional<PanelAccountRecord> Get(uint64 id) = 0;
+    virtual PanelAccountResult Create(std::string_view username, std::string_view password, std::string_view email, uint64& id) = 0;
+    virtual PanelAccountResult SetPassword(uint64 id, std::string_view password, std::string& generated) = 0;
+    virtual PanelAccountResult SetLocked(uint64 id, bool locked) = 0;
+    virtual PanelAccountResult SetSecurityLevel(uint64 id, uint8 level) = 0;
+    virtual PanelAccountResult BanAccount(uint64 id, uint64 seconds, std::string_view by, std::string_view reason) = 0;
+    virtual PanelAccountResult UnbanAccount(uint64 id, std::string_view reason) = 0;
+    virtual PanelAccountResult BanAddress(std::string_view address, uint64 seconds, std::string_view by, std::string_view reason) = 0;
+    virtual PanelAccountResult UnbanAddress(std::string_view address, std::string_view reason) = 0;
+    virtual PanelAccountResult BanMachine(uint64 machineId, uint64 seconds, std::string_view by, std::string_view reason) = 0;
+    virtual PanelAccountResult UnbanMachine(uint64 machineId, std::string_view reason) = 0;
+    virtual std::vector<PanelBanRecord> ListBans() = 0;
+    virtual std::vector<PanelCharacterRecord> CharactersOf(uint64 accountId) = 0;
+};
+
+class PanelAccounts
+{
+public:
+    explicit PanelAccounts(AccountBackend& backend) : _backend(backend) {}
+
+    struct Caller
+    {
+        int64 UserId = 0;
+        std::string Username;
+        uint8 CommandLevel = 0;
+        bool CanRead = false;
+        bool CanReadPii = false;
+        bool CanCreate = false;
+        bool CanEdit = false;
+        bool CanSetPassword = false;
+        bool CanBan = false;
+        bool CanUnban = false;
+        bool CanReadCharacters = false;
+    };
+
+    nlohmann::json Search(Caller const& caller, std::string_view query) const;
+    nlohmann::json Get(Caller const& caller, uint64 id) const;
+    nlohmann::json Create(Caller const& caller, std::string_view username, std::string_view password, std::string_view email, PanelAccountResult& result) const;
+    nlohmann::json ResetPassword(Caller const& caller, uint64 id, PanelAccountResult& result, std::string& generated) const;
+    nlohmann::json SetLocked(Caller const& caller, uint64 id, bool locked, std::string_view reason, PanelAccountResult& result) const;
+    nlohmann::json SetSecurityLevel(Caller const& caller, uint64 id, uint8 level, std::string_view reason, PanelAccountResult& result) const;
+    nlohmann::json Ban(Caller const& caller, std::string_view kind, std::string_view target, uint64 seconds, std::string_view reason, PanelAccountResult& result) const;
+    nlohmann::json Unban(Caller const& caller, std::string_view kind, std::string_view target, std::string_view reason, PanelAccountResult& result) const;
+    nlohmann::json ListBans(Caller const& caller) const;
+    nlohmann::json Characters(Caller const& caller, uint64 accountId) const;
+    nlohmann::json TopSearch(Caller const& caller, std::string_view query) const;
+
+    static nlohmann::json AccountJson(PanelAccountRecord const& record, bool showPii);
+    static nlohmann::json BanJson(PanelBanRecord const& record);
+    static nlohmann::json CharacterJson(PanelCharacterRecord const& record);
+    static std::string_view Describe(PanelAccountResult result) noexcept;
+
+private:
+    bool MayActOn(Caller const& caller, PanelAccountRecord const& target) const;
+
+    AccountBackend& _backend;
+};
