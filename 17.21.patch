+    EXPECT_EQ(sAccountMgr.UnbanMachine(4242), AccountOpResult::Ok);
+    QueryResult munbanned = LoginDatabase.Query("SELECT COUNT(*) FROM `machine_banned` WHERE `machine_id` = 4242 AND (`unbandate` = 0 OR `unbandate` > UNIX_TIMESTAMP())");
