{
  "name": "ambrose-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Project Ambrose by Imjustchico: the npm workspace holding the shared design system and the two surfaces built from it.",
  "license": "MIT",
  "workspaces": [
    "packages/ui",
    "apps/dashboard",
    "apps/launcherui"
  ],
  "scripts": {
    "tokens": "python apps/designtokens/designtokens.py",
    "tokens:check": "python apps/designtokens/designtokens.py --check",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write packages apps/dashboard apps/launcherui vitest.config.ts vitest.canary.config.ts eslint.config.js svelte.config.js .prettierrc.json",
    "format:check": "prettier --check packages apps/dashboard apps/launcherui vitest.config.ts vitest.canary.config.ts eslint.config.js svelte.config.js .prettierrc.json",
    "test": "vitest run --project logic --project chromium --project webkit --project dashboard --project dashboard-browser",
    "test:logic": "vitest run --project logic --project dashboard",
    "test:browser": "vitest run --project chromium --project webkit --project dashboard-browser",
    "build": "npm run build --workspace apps/dashboard --workspace apps/launcherui",
    "test:canary": "vitest run --config vitest.canary.config.ts",
    "e2e": "playwright test --project e2e",
    "screenshots": "playwright test --project screenshots",
    "storybook": "storybook dev --port 6006 --no-open --config-dir packages/ui/.storybook",
    "storybook:build": "storybook build --config-dir packages/ui/.storybook --output-dir storybook-static",
    "checks": "python apps/ci/ci_frontend_checks.py",
    "icons": "python apps/designtokens/icons.py",
    "cache": "python apps/ci/ci_npm_cache.py"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/karla": "5.3.0",
    "@iconify-json/lucide": "1.2.134",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-svelte-csf": "5.1.3",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/svelte-vite": "10.6.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.6",
    "@vitest/browser-playwright": "4.1.11",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "playwright": "1.63.0",
    "prettier": "3.9.8",
    "prettier-plugin-svelte": "3.5.2",
    "storybook": "10.6.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.0",
    "unplugin-icons": "24.0.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
