{
  "item": "C-41",
  "format": 1,
  "sample_interval_seconds": 1,
  "stale_after_seconds": 5,
  "history_ranges": [
    {
      "id": "5m",
      "label": "5 minutes",
      "seconds": 300
    },
    {
      "id": "1h",
      "label": "1 hour",
      "seconds": 3600
    },
    {
      "id": "6h",
      "label": "6 hours",
      "seconds": 21600
    },
    {
      "id": "24h",
      "label": "24 hours",
      "seconds": 86400
    },
    {
      "id": "7d",
      "label": "7 days",
      "seconds": 604800
    },
    {
      "id": "30d",
      "label": "30 days",
      "seconds": 2592000
    }
  ],
  "pages": [
    {
      "id": "overview",
      "title": "Overview",
      "permission": "metrics.read",
      "panels": [
        {
          "id": "host-health",
          "title": "Host health",
          "scope": "node",
          "series": [
            "node.cpu_percent",
            "node.memory_bytes",
            "node.disk_free_bytes"
          ]
        },
        {
          "id": "app-health",
          "title": "Application health",
          "scope": "app",
          "series": [
            "app.cpu_percent",
            "app.memory_bytes",
            "app.network_in_bytes",
            "app.network_out_bytes",
            "app.sessions",
            "app.tick_time_max_ms"
          ]
        },
        {
          "id": "game-state",
          "title": "Game state",
          "scope": "realm",
          "series": [
            "realm.players_online",
            "realm.sessions_at_character_select"
          ]
        }
      ]
    },
    {
      "id": "application",
      "title": "Application",
      "permission": "metrics.read",
      "panels": [
        {
          "id": "process",
          "title": "Process",
          "scope": "app",
          "series": [
            "app.cpu_percent",
            "app.memory_bytes",
            "app.thread_count",
            "app.handle_count"
          ]
        },
        {
          "id": "traffic",
          "title": "Traffic",
          "scope": "app",
          "series": [
            "app.network_in_bytes",
            "app.network_out_bytes",
            "app.active_downloads"
          ]
        },
        {
          "id": "operations",
          "title": "Operations",
          "scope": "app",
          "series": [
            "app.tick_time_average_ms",
            "app.tick_time_max_ms",
            "app.pending_sql_updates",
            "app.settings_generation",
            "app.last_reload_result",
            "app.client_revision"
          ]
        }
      ]
    },
    {
      "id": "realm",
      "title": "Realm",
      "permission": "metrics.read",
      "panels": [
        {
          "id": "players",
          "title": "Players",
          "scope": "realm",
          "series": [
            "realm.players_online",
            "realm.sessions_at_character_select"
          ]
        },
        {
          "id": "zone-players",
          "title": "Players by zone",
          "scope": "zone",
          "series": [
            "zone.players_online"
          ]
        }
      ]
    }
  ],
